# Copy to .env and fill in real values. NEVER commit .env.
#
# EXPO_PUBLIC_* variables are embedded in the client bundle — only ever put
# publishable/anon keys here, never service-role or secret keys.
#
# For EAS builds these must ALSO exist as EAS environment variables (a cloud
# build never sees your local .env): `eas env:create` — see docs/APP_STORE.md.

# Supabase (Project Settings → API Keys) — required
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# PostHog — the §6 liquidity metrics stay no-op until this exists.
# Free project at posthog.com; host is the region you picked at signup.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Server-side only: Supabase Edge Function secrets, NOT in the app bundle ---
# Set with `supabase secrets set NAME=value` (or as GitHub Actions secrets, which
# the Supabase deploy workflow syncs for you):
#   ANTHROPIC_API_KEY          — moderation + selfie verification classifier
#   SUPABASE_SERVICE_ROLE_KEY  — provided automatically inside Edge Functions
#   SUPABASE_ANON_KEY          — provided automatically (delete-account uses it
#                                to verify the caller's JWT)

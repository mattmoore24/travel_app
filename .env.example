# Copy to .env and fill in real values. NEVER commit .env.
#
# EXPO_PUBLIC_* variables are embedded in the client bundle — only ever put
# publishable/anon keys here, never service-role or secret keys.

# Supabase (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side only (Supabase Edge Function secrets, NOT in the app bundle) ---
# Set these with `supabase secrets set`, never as EXPO_PUBLIC_*:
#   ANTHROPIC_API_KEY   — first-message moderation classifier (Phase 5)
#   SUPABASE_SERVICE_ROLE_KEY — provided automatically inside Edge Functions

# --- Coming in later phases (placeholders, not needed yet) ---
# EXPO_PUBLIC_POSTHOG_API_KEY=            # Phase 2+ analytics
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EXPO_PUBLIC_MAPBOX_TOKEN=               # only if Phase 3 map evaluation picks Mapbox

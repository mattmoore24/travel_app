{
  "expo": {
    "name": "Samewhere",
    "slug": "samewhere",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samewhere",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.mattmoore.samewhere",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:link.samewhere.io"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1020",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1020",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you choose profile photos to share with other travelers.",
          "cameraPermission": "Lets you take a photo for your profile, for a chat, or a selfie to verify your profile photos are really you.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": false,
          "motionUsagePermission": "Samewhere does not track motion. Apple requires this notice because a software library the app is built with refers to the motion tools."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mattmoore24s-team",
    "updates": {
      "url": "https://u.expo.dev/4e5da662-4b34-482a-bc54-8578d237bf54"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "4e5da662-4b34-482a-bc54-8578d237bf54"
      }
    }
  }
}
